# Desktop development only: absolute directory for profiles.json and profile databases.
# Takes precedence over DATABASE_URL. Ignored by release, packaged, and mobile builds.
# WF_DATA_DIR=/absolute/path/to/wealthfolio-dev

# Legacy default-database override when WF_DATA_DIR is not active.
# DATABASE_URL=../db/app.db

# Wealthfolio Connect - Required for cloud sync feature
CONNECT_AUTH_URL=https://your-auth-provider.example.com
CONNECT_AUTH_PUBLISHABLE_KEY=your-publishable-key
CONNECT_API_URL=https://api.wealthfolio.app
CONNECT_OAUTH_CALLBACK_URL=https://connect.wealthfolio.app/auth/callback
